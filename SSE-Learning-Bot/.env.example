# ==============================================================================
# 1. CORE LLM (Required for AI Professor teaching & doubt responses)
# ==============================================================================
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# 2. VOICE & AUDIO (Required for Voice Input and AI Voice Playback)
# ==============================================================================
# Deepgram handles both STT (transcribing student voice) and TTS (AI speaking voice)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Speech-to-Text Model (student mic transcription)
DEEPGRAM_STT_MODEL=nova-3

# Text-to-Speech Voice (AI avatar voice playback)
# Voices: aura-asteria-en (female), aura-luna-en (female), aura-arcas-en (male), aura-helios-en (male)
DEEPGRAM_TTS_MODEL=aura-asteria-en

# ==============================================================================
# 3. TOPIC SEARCH & INTELLIGENT GATHERING (Tavily & OpenRouter)
# ==============================================================================
# Tavily API for live web search and document gathering
TAVILY_API_KEY=your_tavily_api_key_here

# OpenRouter API Key for topic content synthesis
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Models:
# - NVIDIA Nemotron: nvidia/llama-3.1-nemotron-70b-instruct:free
# - Google Gemma: google/gemma-2-27b-it:free
# - Free Model Router: openrouter/auto
OPENROUTER_MODEL=nvidia/llama-3.1-nemotron-70b-instruct:free



